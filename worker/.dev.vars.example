# Copy to worker/.dev.vars (git-ignored) for `npm run dev -w worker`.
# DEV_MODE skips the Access check, and only for requests to localhost.
DEV_MODE=true
# JSON keyed by Proxmox target id; values are USER@REALM!TOKENID=SECRET
PVE_TOKENS='{"pve":"","pve2":"","pve3":"","pve4":"","pve5":"","pve6":"","pve7":""}'
GITHUB_TOKEN=
ARGOCD_TOKEN=
# UniFi OS API key for the UDM (Vault kv/github/hdctl/unifi)
UNIFI_API_KEY=
# Web Push keypair: optional locally. Left out, the Notifications page says
# "Not set up yet" and everything else works. Any P-256 pair will do here (it
# needn't be production's): the public key raw and base64url, the private key
# as its JWK "d". Push works on localhost, which counts as a secure context.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
