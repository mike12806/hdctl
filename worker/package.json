{
  "name": "hdctl-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply hdctl-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply hdctl-db --remote"
  },
  "dependencies": {
    "hono": "4.13.17",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261109.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  }
}
